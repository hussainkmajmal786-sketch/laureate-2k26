# ─────────────────────────────────────────────────────────────
# Laureate 2K26 — environment
# Copy to .env.local for local dev. On Vercel, add both of these
# under Project Settings → Environment Variables (all environments).
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("anon") key. Safe to expose to the browser — row-level
# security is what actually protects the data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Google Drive (optional) ──────────────────────────────────
# Photo import files into Drive. Without these the app runs fine;
# the Photo Import screen simply reports Drive as not connected.
# See WORKFLOW.md for how to create the service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Folder id from the Drive URL. Share that folder with the service
# account email as Editor — service accounts have no storage quota.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
